---
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.tsx';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas anchas (mapas de asientos, tablas de admin) salen del contenedor angosto. */
  wide?: boolean;
}

const {
  title = 'Cine',
  description = 'Reservá asientos, elegí tu confitería y gestioná funciones.',
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title === 'Cine' ? 'Cine' : `${title} · Cine`}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <header
      class="border-ink-800 bg-ink-950/85 sticky top-0 z-30 border-b backdrop-blur"
    >
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-3">
        <a href="/" class="text-brand-400 shrink-0 text-lg font-black tracking-tight">
          CINE
        </a>
        <!-- La isla de navegación conserva su estado entre transiciones y recibe el `pathname` nuevo. -->
        <NavBar pathname={pathname} client:load transition:persist />
      </div>
    </header>

    <main class={`mx-auto w-full px-4 py-8 ${wide ? 'max-w-7xl' : 'max-w-5xl'}`}>
      <slot />
    </main>

    <footer class="border-ink-800 text-ink-600 mt-16 border-t px-4 py-8 text-center text-xs">
      <p>
        Cine · frontend del backend TP-AppsInter. La disponibilidad de asientos es orientativa hasta
        que confirmás la reserva.
      </p>
    </footer>
  </body>
</html>
