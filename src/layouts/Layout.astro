---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.tsx';
import NetBackground from '../components/NetBackground.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas anchas (mapas de asientos, tablas de admin) salen del contenedor angosto. */
  wide?: boolean;
}

const {
  title = 'Cine',
  description = 'Reservá asientos, elegí tu confitería y gestioná funciones.',
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title === 'Cine' ? 'Cine' : `${title} · Cine`}</title>
    <Font cssVariable="--font-pixelify" preload />
    <Font cssVariable="--font-press-start" />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <NetBackground />
    <!-- Primer elemento enfocable: permite saltar la navegación repetida (WCAG 2.4.1). -->
    <a
      href="#contenido"
      class="cine-btn cine-btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Saltar al contenido principal
    </a>
    <header class="border-brand-600 bg-ink-950/85 sticky top-0 z-30 border-b-2 shadow-[0_4px_0_rgb(0_0_0/0.35)] backdrop-blur-sm">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-3">
        <a
          href="/"
          class="font-display text-brand-400 shrink-0 text-base [text-shadow:2px_2px_0_var(--color-brand-700)]"
        >
          CINE
        </a>
        <!--
          La isla de navegación conserva su estado entre transiciones y recibe el `pathname` nuevo.
          Sus enlaces son `<a>` comunes que funcionan sin JS, así que se hidrata en `idle`.
        -->
        <NavBar pathname={pathname} client:idle transition:persist />
      </div>
    </header>

    <main
      id="contenido"
      tabindex="-1"
      class:list={['mx-auto w-full px-4 py-8 focus:outline-none', wide ? 'max-w-7xl' : 'max-w-5xl']}
    >
      <slot />
    </main>

    <footer class="border-ink-700 bg-ink-950/85 text-ink-500 mt-16 flex flex-col items-center gap-3 border-t-2 px-4 py-8 text-center text-xs">
      <p>
        Cine · frontend del backend TP-AppsInter. La disponibilidad de asientos es orientativa hasta
        que confirmás la reserva.
      </p>
      <!-- Con movimiento reducido el fondo ya está quieto, así que el control sobra. -->
      <button
        type="button"
        data-net-toggle
        aria-pressed="false"
        class="cine-btn cine-btn-ghost text-xs motion-reduce:hidden"
      >
        Pausar fondo animado
      </button>
    </footer>
  </body>
</html>
