---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.tsx';
import NetBackground from '../components/NetBackground.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas anchas (mapas de asientos, tablas de admin) salen del contenedor angosto. */
  wide?: boolean;
}

const {
  title = 'Cine',
  description = 'Reservá asientos, elegí tu confitería y gestioná funciones.',
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title === 'Cine' ? 'Cine' : `${title} · Cine`}</title>
    <Font cssVariable="--font-pixelify" preload />
    <Font cssVariable="--font-press-start" />
    <ClientRouter />
  </head>
  <!--
    Columna flexible de al menos un viewport: `<main>` absorbe el alto sobrante y el pie queda
    abajo aunque la página sea corta. `dvh` sigue el alto visible real en móviles. El fondo es
    `fixed` y el enlace de salto `absolute`, así que no participan del flujo.
  -->
  <body class="flex min-h-dvh flex-col">
    <NetBackground />
    <!-- Primer elemento enfocable: permite saltar la navegación repetida (WCAG 2.4.1). -->
    <a
      href="#contenido"
      class="cine-btn cine-btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Saltar al contenido principal
    </a>
    <header class="border-brand-600 bg-ink-950/95 shadow-ledge sticky top-0 z-30 border-b-2">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-4 py-3">
        <a
          href="/"
          class="font-display text-brand-400 text-shadow-pixel text-shadow-brand-700 shrink-0 text-base"
        >
          CINE
        </a>
        <!--
          La isla de navegación conserva su estado entre transiciones y recibe el `pathname` nuevo.
          Sus enlaces son `<a>` comunes que funcionan sin JS, así que se hidrata en `idle`.
        -->
        <NavBar pathname={pathname} client:idle transition:persist />
      </div>
    </header>

    <main
      id="contenido"
      tabindex="-1"
      class:list={[
        'mx-auto w-full flex-1 px-4 py-8 focus:outline-none',
        wide ? 'max-w-7xl' : 'max-w-5xl',
      ]}
    >
      <slot />
    </main>

    <footer class="border-ink-700 bg-ink-950/85 text-ink-500 mt-16 flex flex-col items-center gap-3 border-t-2 px-4 py-8 text-center text-xs">
      <p>
        Cine · frontend del backend TP-AppsInter. La disponibilidad de asientos es orientativa hasta
        que confirmás la reserva.
      </p>
      <nav aria-label="Legal">
        <a href="/privacidad" class="cine-link">
          Política de privacidad
        </a>
      </nav>
      <!--
        Fondo quieto por defecto (WCAG 3 "No visual motion"); `NetBackground.astro` aplica y
        recuerda la elección. Con movimiento reducido, "Animado" no se ofrece.
      -->
      <fieldset data-net-mode class="flex flex-col items-center gap-1 forced-colors:hidden">
        <legend class="text-ink-300 mb-1">Fondo</legend>
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1">
          <label class="flex items-center gap-1.5 motion-reduce:hidden">
            <input type="radio" name="net-mode" value="animado" class="accent-brand-500 size-4" />
            Animado
          </label>
          <label class="flex items-center gap-1.5">
            <input
              type="radio"
              name="net-mode"
              value="quieto"
              checked
              class="accent-brand-500 size-4"
            />
            Quieto
          </label>
          <label class="flex items-center gap-1.5">
            <input type="radio" name="net-mode" value="liso" class="accent-brand-500 size-4" />
            Liso
          </label>
        </div>
      </fieldset>
    </footer>
  </body>
</html>
