---
import Layout from '../layouts/Layout.astro';
import NowShowing from '../components/catalogue/NowShowing.tsx';
---

<Layout title="Cine" description="Mirá qué hay en cartelera y reservá tus asientos." wide>
  <section class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight">Hoy en el cine</h1>
    <p class="text-ink-500 mt-2 max-w-prose text-sm">
      Podés recorrer todo el catálogo sin cuenta: solo necesitás iniciar sesión para reservar.
    </p>
  </section>

  <NowShowing client:load />
</Layout>
