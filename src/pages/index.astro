---
import Layout from '../layouts/Layout.astro';
import NowShowing from '../components/catalogue/NowShowing.tsx';
---

<Layout
  title="Cine"
  description="Browse what is showing tonight and reserve your seats."
  wide
>
  <section class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight">Tonight at the cinema</h1>
    <p class="text-ink-500 mt-2 max-w-prose text-sm">
      The whole catalogue is browsable without an account — you only need to sign in when you
      reserve.
    </p>
  </section>

  <NowShowing client:load />
</Layout>
