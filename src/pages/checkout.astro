---
import Layout from '../layouts/Layout.astro';
import Checkout from '../components/booking/Checkout.tsx';
import { LoadingBlock } from '../components/ui/SubmitButton.tsx';
---

<!--
  `/checkout/:screeningId` se implementa como `/checkout?screening=<uuid>`,
  con la selección de asientos en `&seats=<uuid,uuid>`.
-->
<Layout title="Confirmar reserva" description="Confirmá tus asientos y tu confitería." wide>
  <Checkout client:only="react">
    <div slot="fallback">
      <LoadingBlock label="Preparando tu pedido…" />
    </div>
  </Checkout>
</Layout>
