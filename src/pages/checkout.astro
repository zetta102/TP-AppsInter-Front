---
import Layout from '../layouts/Layout.astro';
import Checkout from '../components/booking/Checkout.tsx';
---

<!--
  The spec's `/checkout/:screeningId` becomes `/checkout?screening=<uuid>`,
  with the seat selection carried in `&seats=<uuid,uuid>`.
-->
<Layout title="Checkout" description="Confirm your seats and concessions." wide>
  <Checkout client:load />
</Layout>
