---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/auth/RegisterForm.tsx';
---

<Layout title="Crear cuenta" description="Creá una cuenta de Cine para reservar asientos.">
  <div class="mx-auto max-w-md">
    <h1 class="mb-1 text-2xl font-bold">Creá tu cuenta</h1>
    <p class="text-ink-500 mb-6 text-sm">
      Las cuentas nuevas siempre son de cliente. El acceso de administrador se otorga desde el
      servidor.
    </p>
    <RegisterForm client:load />
  </div>
</Layout>
