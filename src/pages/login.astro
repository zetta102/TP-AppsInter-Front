---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/LoginForm.tsx';
---

<Layout title="Sign in" description="Sign in to book seats and manage your reservations.">
  <div class="mx-auto max-w-md">
    <h1 class="mb-1 text-2xl font-bold">Welcome back</h1>
    <p class="text-ink-500 mb-6 text-sm">
      Browsing is open to everyone — you only need an account to reserve seats.
    </p>
    <LoginForm client:load />
  </div>
</Layout>
