---
import Layout from '../layouts/Layout.astro';
import LoginForm from '../components/auth/LoginForm.tsx';
---

<Layout title="Iniciar sesión" description="Iniciá sesión para reservar asientos y gestionar tus reservas.">
  <div class="mx-auto max-w-md">
    <h1 class="mb-1 text-2xl font-bold">Hola de nuevo</h1>
    <p class="text-ink-500 mb-6 text-sm">
      Cualquiera puede ver la cartelera: solo necesitás una cuenta para reservar asientos.
    </p>
    <LoginForm client:load />
  </div>
</Layout>
