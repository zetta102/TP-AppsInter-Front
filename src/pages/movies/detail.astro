---
import Layout from '../../layouts/Layout.astro';
import MovieDetail from '../../components/catalogue/MovieDetail.tsx';
import { LoadingBlock } from '../../components/ui/SubmitButton.tsx';
---

<!--
  La salida estática no puede prerenderizar un UUID desconocido, así que `/movies/:id`
  se implementa como `/movies/detail?id=<uuid>` y se resuelve en el cliente.
-->
<Layout title="Película" description="Detalle de la película y próximas funciones.">
  <MovieDetail client:only="react">
    <div slot="fallback">
      <LoadingBlock label="Cargando la película…" />
    </div>
  </MovieDetail>
</Layout>
