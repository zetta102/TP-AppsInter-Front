---
import Layout from '../layouts/Layout.astro';
import Account from '../components/account/Account.tsx';
import { LoadingBlock } from '../components/ui/SubmitButton.tsx';
---

<Layout title="Tu cuenta" description="Administrá tu perfil y tu contraseña.">
  <h1 class="mb-6 text-2xl font-bold">Tu cuenta</h1>
  <Account client:only="react">
    <div slot="fallback">
      <LoadingBlock label="Cargando tu cuenta…" />
    </div>
  </Account>
</Layout>
