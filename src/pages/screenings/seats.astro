---
import Layout from '../../layouts/Layout.astro';
import SeatPicker from '../../components/booking/SeatPicker.tsx';
import { LoadingBlock } from '../../components/ui/Feedback.tsx';
---

<!--
  `/screenings/:id/seats` se implementa como `/screenings/seats?id=<uuid>`: la salida
  estática no puede prerenderizar un UUID desconocido. El mapa de asientos es público;
  con sesión se envía el token para que las retenciones propias figuren como disponibles.
-->
<Layout title="Elegí tus asientos" description="Elegí tus asientos para esta función." wide>
  <SeatPicker client:only="react">
    <div slot="fallback">
      <LoadingBlock label="Cargando el mapa de asientos…" />
    </div>
  </SeatPicker>
</Layout>
