---
/**
 * Fondo "Net": dos capas de baldosas de 16 bits al estilo de las áreas de Internet de Mega Man
 * Battle Network. Lejos, una grilla de circuito; cerca, los pares "6 7", que en modo animado se
 * desplazan en diagonal y giran sobre su eje vertical como los emblemas de MMBN 4-6.
 *
 * El giro vive dentro de `net-67-spin.svg`, con cuadros de píxeles dibujados a mano y sin escalados
 * que emborronen. La página no puede pausar la animación de una imagen: fuera del modo animado se
 * usa la baldosa estática `net-67.svg`.
 *
 * Persiste entre transiciones (`transition:persist`): el `ClientRouter` reemplaza el `<body>` en
 * cada navegación y, sin persistir, la animación volvería a empezar.
 *
 * Modos (`data-mode`), elegidos con el grupo "Fondo" del pie y recordados en `localStorage`:
 *  - `quieto` (predeterminado): baldosas fijas. WCAG 3 "No visual motion" prohíbe movimiento de
 *    más de 5 s salvo que la persona lo pida, así que la animación es opcional;
 *  - `animado`: solo con `prefers-reduced-motion: no-preference`;
 *  - `liso`: sin baldosas detrás del texto, solo el degradé (WCAG 3 "Background adjustable").
 * Con colores forzados (alto contraste) el fondo no se dibuja.
 */
---

<div class="net-bg" aria-hidden="true" transition:persist="net-bg">
  <div class="net-layer net-layer-far"></div>
  <div class="net-layer net-layer-near"></div>
</div>

<!-- Antes del primer pintado: aplica el modo guardado sin mostrar un cuadro del predeterminado. -->
<script is:inline>
  try {
    const mode = window.localStorage.getItem('cine:fondo');
    if (mode === 'animado' || mode === 'liso') {
      document.querySelector('.net-bg')?.setAttribute('data-mode', mode);
    }
  } catch {
    // Sin almacenamiento: queda el modo predeterminado.
  }
</script>

<script>
  type NetMode = 'animado' | 'quieto' | 'liso';

  const STORAGE_KEY = 'cine:fondo';

  function isNetMode(value: unknown): value is NetMode {
    return value === 'animado' || value === 'quieto' || value === 'liso';
  }

  function readMode(): NetMode {
    try {
      const stored = window.localStorage.getItem(STORAGE_KEY);
      return isNetMode(stored) ? stored : 'quieto';
    } catch {
      return 'quieto';
    }
  }

  function writeMode(mode: NetMode) {
    try {
      window.localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      // Sin almacenamiento (navegación privada) la elección vale solo para esta página.
    }
  }

  function applyMode(mode: NetMode) {
    document.querySelector('.net-bg')?.setAttribute('data-mode', mode);
    // Con movimiento reducido la opción "Animado" está oculta y el fondo no se mueve: se marca
    // "Quieto", que es lo que se ve.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shown = reduced && mode === 'animado' ? 'quieto' : mode;
    for (const input of document.querySelectorAll<HTMLInputElement>('input[name="net-mode"]')) {
      input.checked = input.value === shown;
    }
  }

  // El pie se reemplaza en cada navegación (el fondo no): se vuelve a enlazar el grupo cada vez.
  document.addEventListener('astro:page-load', () => {
    applyMode(readMode());
    document.querySelector('[data-net-mode]')?.addEventListener('change', (event) => {
      const { value } = event.target as HTMLInputElement;
      if (!isNetMode(value)) return;
      writeMode(value);
      applyMode(value);
    });
  });
</script>

<style>
  .net-bg {
    --net-tile: 96px;

    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Degradé en cuatro bandas duras, como una paleta de 16 bits: sin interpolación suave. */
    background: linear-gradient(
      to bottom,
      var(--color-ink-950) 0 25%,
      color-mix(in oklch, var(--color-ink-950) 67%, var(--color-ink-900)) 25% 50%,
      color-mix(in oklch, var(--color-ink-950) 33%, var(--color-ink-900)) 50% 75%,
      var(--color-ink-900) 75% 100%
    );
  }

  /* Una baldosa de margen arriba y a la derecha: el desplazamiento nunca deja huecos. */
  .net-layer {
    position: absolute;
    inset: calc(var(--net-tile) * -1) calc(var(--net-tile) * -1) 0 0;
    background-size: var(--net-tile) var(--net-tile);
    image-rendering: pixelated;
  }

  .net-layer-far {
    background-image: url('../assets/net-grid.svg');
  }

  .net-layer-near {
    background-image: url('../assets/net-67.svg');
  }

  .net-bg[data-mode='liso'] .net-layer {
    display: none;
  }

  /*
   * `steps()` con tantos pasos como píxeles tiene la baldosa: avanza de a 1px entero, sin
   * subpíxeles que emborronen el arte. Recorrer una baldosa exacta hace el bucle invisible.
   */
  @media (prefers-reduced-motion: no-preference) {
    .net-bg[data-mode='animado'] .net-layer {
      will-change: transform;
    }

    /* La grilla lejana va a mitad de velocidad: paralaje. */
    .net-bg[data-mode='animado'] .net-layer-far {
      animation: net-scroll 6.4s steps(96) infinite;
    }

    .net-bg[data-mode='animado'] .net-layer-near {
      background-image: url('../assets/net-67-spin.svg');
      animation: net-scroll 3.2s steps(96) infinite;
    }
  }

  /* Alto contraste: el sistema impone sus colores y las baldosas solo estorbarían la lectura. */
  @media (forced-colors: active) {
    .net-bg {
      display: none;
    }
  }

  @keyframes net-scroll {
    to {
      transform: translate(calc(var(--net-tile) * -1), var(--net-tile));
    }
  }
</style>
